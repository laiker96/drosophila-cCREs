digraph workflow {
  graph [rankdir=LR, bgcolor="transparent", pad=0.25, nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#40566b", fillcolor="#f4f7fa", margin="0.13,0.08"];
  edge [color="#607d8b", arrowsize=0.7];

  accessions [label="Accession + library + assay + context"];
  download [label="Checksummed FASTQ download"];
  trim [label="FastQC + Cutadapt\n--until-stage trimming"];
  align [label="Bowtie2 + merge + duplicate mark + filter\n--until-stage alignment"];
  bammanifest [label="Checksummed pending\nfinal-BAM manifest", fillcolor="#e5f1ff"];
  qc [label="Peaks + FRiP + assay QC + MultiQC\n--until-stage qc", fillcolor="#f1e9fa"];
  reviewtable [label="Per-library QC review TSV\nuser sets pass/fail", fillcolor="#f8e8f5"];
  reviewedbam [label="Reviewed final-BAM manifest", fillcolor="#e5f1ff"];
  context [label="Replicate-supported ATAC peaks\nper input-table context", fillcolor="#dff3e5"];
  master [label="Variable-width summit-aware\nmaster DHS registry\n--until-stage master", fillcolor="#ccebd6"];
  mastermanifest [label="Checksummed master bundle", fillcolor="#e7f5eb"];

  validate [label="Validate accepted BAMs + master\nno upstream fallback", fillcolor="#eef6ff"];
  units [label="ATAC Tn5 insertions +\nH3K27ac fragments", fillcolor="#fff4d8"];
  exact [label="Exact master-interval\nraw counts + CPM/kb", fillcolor="#fff4d8"];
  background [label="10-kb autosomal background counts", fillcolor="#fff4d8"];
  tmm [label="Assay-specific background TMM\nfactors + normalized contexts", fillcolor="#fff0c7"];
  quantify [label="Master-DHS activity table\n--until-stage quantification", fillcolor="#ffe5a8"];
  windows [label="Three 500-bp H3K27ac windows\nmax after context averaging", fillcolor="#fff4d8"];
  mixture [label="Guarded two-Gaussian fit\nlow/high + explicit warnings", fillcolor="#f7e4b2"];
  catalog [label="Long + wide catalogs\nactive elements per context\n--until-stage catalog", fillcolor="#f7e4b2"];
  browser [label="Context BEDs + mean TMM BigWigs\nportable IGV sessions", fillcolor="#e1f0f7"];
  report [label="Integrated HTML/PDF QC report\ninputs, outputs, statistics + plots\n--until-stage report", fillcolor="#e8e1f5"];

  accessions -> download -> trim -> align -> qc -> reviewtable -> reviewedbam -> context -> master -> mastermanifest;
  align -> bammanifest -> reviewtable;
  reviewedbam -> validate;
  mastermanifest -> validate -> units;
  units -> exact -> tmm;
  units -> background -> tmm -> quantify;
  units -> windows -> mixture;
  master -> windows;
  quantify -> mixture -> catalog;
  tmm -> browser;
  catalog -> browser -> report;
  reviewedbam -> report [style=dashed];
  mastermanifest -> report [style=dashed];
}
